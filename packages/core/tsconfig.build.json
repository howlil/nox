{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./dist/types",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
