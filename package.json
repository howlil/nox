{
  "name": "nox-obsidian",
  "version": "1.3.2",
  "description": "Nox is an AI learning companion for Obsidian with a pluggable agent runtime",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/nox.git"
  },
  "homepage": "https://github.com/howlil/nox",
  "bugs": {
    "url": "https://github.com/howlil/nox/issues"
  },
  "main": "dist/main.js",
  "scripts": {
    "architecture:graph": "node scripts/architecture-graph.mjs",
    "headless:check": "node scripts/headless.mjs check",
    "headless:demo": "node scripts/headless.mjs demo",
    "core:build": "node scripts/build-core.mjs",
    "core:verify": "node scripts/check-core.mjs",
    "core:hosts": "node scripts/check-core-hosts.mjs",
    "browser:verify": "node scripts/check-browser-host.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:build": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "lint": "eslint src",
    "lint:typed": "eslint src/agent/ChatGptAdapter.ts src/agent/CodexAdapter.ts src/chat/preview-frame.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:all": "node scripts/test.mjs all",
    "bench:research": "node scripts/bench-research.mjs",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm lint && pnpm lint:css && pnpm test:unit && pnpm test:integration && pnpm docs:check && pnpm release:check && pnpm headless:check && pnpm core:verify && pnpm core:hosts && pnpm browser:verify && pnpm build && pnpm test:artifacts",
    "test:artifacts": "node scripts/verify-artifacts.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "release:check": "node scripts/check-release.mjs",
    "lint:css": "node scripts/check-css-sources.mjs",
    "ci:critical": "node scripts/ci/obsidian-critical-policy.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "learning"
  ],
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "obsidian": "latest",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@nox/core": "workspace:*",
    "elkjs": "0.11.0",
    "motion": "^13.4.2"
  }
}
