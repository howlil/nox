{
  "name": "nox-obsidian",
  "version": "0.0.1",
  "description": "Nox is an AI learning companion for Obsidian with a pluggable agent runtime",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/nox.git"
  },
  "homepage": "https://github.com/howlil/nox",
  "bugs": {
    "url": "https://github.com/howlil/nox/issues"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:build": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "lint": "eslint src",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:all": "node scripts/test.mjs all",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build && pnpm test:artifacts",
    "test:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "learning"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "obsidian": "latest",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "motion": "^13.4.2"
  }
}
