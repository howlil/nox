{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@nox/core": ["packages/core/src/index.ts"] },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": ["ES2018", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "headless/src/**/*.ts", "browser/src/**/*.ts"]
}
